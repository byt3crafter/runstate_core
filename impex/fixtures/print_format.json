  "css": ".label-container {\r\n    width: 55mm;\r\n    height: 25mm;\r\n    padding: 0px;\r\n    box-sizing: border-box;\r\n    font-family: Arial, sans-serif;\r\n    border: 0px solid #ddd;\r\n    display: inline-block;\r\n}\r\n\r\n.itemcode-label {\r\n    font-size: 18pt;\r\n    font-weight: 700;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    white-space: nowrap;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.itemname-label {\r\n    font-size: 8pt;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    white-space: nowrap;\r\n    margin-bottom: 3px;\r\n}",
