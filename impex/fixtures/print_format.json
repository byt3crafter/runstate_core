  "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t<h2><div>Item</div><br><small class=\\\"sub-heading\\\">{{ doc.name }}</small>\\t\\t\\t\\t</h2></div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"barcodes\", \"print_hide\": 0, \"label\": \"Barcodes\", \"visible_columns\": [{\"fieldname\": \"barcode\", \"print_width\": \"\", \"print_hide\": 0}, {\"fieldname\": \"barcode_type\", \"print_width\": \"\", \"print_hide\": 0}, {\"fieldname\": \"posa_uom\", \"print_width\": \"\", \"print_hide\": 0}]}]",
  "html": "{% for item in doc.items %}\r\n    {% set labels_to_print = item.custom_label_qty if item.custom_label_qty > 0 else 0 %}\r\n    {% if labels_to_print > 0 %}\r\n        {% for i in range(labels_to_print) %}\r\n            <div class=\"label-container\">\r\n                <p class=\"itemcode-label\">{{ item.item_code }}</p>\r\n                <p class=\"itemname-label\">{{ item.item_name }}</p>\r\n                <p class=\"supplier-part-no\">{{ item.supplier_part_no }}</p>\r\n                <p class=\"docname-label\">{{ doc.name }}</p>\r\n            </div>\r\n        {% endfor %}\r\n    {% endif %}\r\n{% endfor %}",
